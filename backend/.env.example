# ── Server ──
PORT=4000
NODE_ENV=development
JWT_SECRET=ganti-dengan-string-acak-minimal-32-karakter
JWT_EXPIRES_IN=8h
CORS_ORIGINS=*
PUBLIC_BASE_URL=http://localhost:4000

# ── Database (MySQL Laragon: port 3316, user root tanpa password) ──
DATABASE_URL=mysql://root:@127.0.0.1:3316/talago_royal

# ── Redis Pub/Sub (kosongkan untuk memakai event bus in-memory) ──
REDIS_URL=redis://127.0.0.1:6379

# ── Cloud Printing ──
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=25
FILE_RETENTION_DAYS=7
# Path ke soffice (LibreOffice) untuk konversi .doc/.docx -> PDF (opsional)
SOFFICE_PATH=

# ── Payment gateway: mock | midtrans ──
PAYMENT_PROVIDER=mock
PAYMENT_EXPIRY_MINUTES=15
MIDTRANS_SERVER_KEY=
MIDTRANS_IS_PRODUCTION=false
