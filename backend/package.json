{
  "name": "talago-royal-backend",
  "version": "1.0.0",
  "description": "REST API + realtime gateway Sistem Informasi Terintegrasi Talago Royal",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "start": "node --env-file-if-exists=.env src/server.js",
    "test": "node --test \"test/**/*.test.js\"",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "node --env-file-if-exists=.env prisma/seed.js",
    "db:reset": "prisma migrate reset --force",
    "samples": "node scripts/generate-samples.js",
    "smoke": "node --env-file-if-exists=.env scripts/smoke.js"
  },
  "prisma": {
    "seed": "node --env-file-if-exists=.env prisma/seed.js"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "adm-zip": "^0.6.1",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.5.0",
    "pdf-lib": "^1.17.1",
    "pdfkit": "^0.20.2",
    "prisma": "^6.19.3",
    "socket.io": "^4.8.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "socket.io-client": "^4.8.4"
  }
}
