# Konfigurasi docker-compose. Untuk menjalankan di laptop, file ini TIDAK wajib —
# semua nilai sudah punya default. Untuk server: salin menjadi `.env` lalu ubah nilainya.

# Port aplikasi di browser (http://localhost:8080)
APP_PORT=8080
# Port MySQL & Redis yang dibuka ke laptop (untuk HeidiSQL / debugging)
MYSQL_PORT=3317
REDIS_PORT=6380

# WAJIB diganti di server: string acak minimal 32 karakter
JWT_SECRET=dev-only-ganti-secret-ini-di-server-production-0000
MYSQL_ROOT_PASSWORD=talago_root

# Alamat publik aplikasi (dipakai untuk URL webhook Midtrans)
PUBLIC_BASE_URL=http://localhost:8080

# Pembayaran: mock (simulasi) atau midtrans
PAYMENT_PROVIDER=mock
MIDTRANS_SERVER_KEY=
MIDTRANS_IS_PRODUCTION=false

# Isi data demo otomatis jika database masih kosong (tidak pernah menimpa data yang ada)
SEED_IF_EMPTY=true

# true = image backend ikut memasang LibreOffice untuk konversi .doc/.docx (±600 MB lebih besar)
WITH_LIBREOFFICE=false

# Dipakai server production untuk menarik image dari GitHub Container Registry
IMAGE_PREFIX=talago-royal
IMAGE_TAG=latest
